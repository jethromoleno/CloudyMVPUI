{
  "name": "cloudy-mvp-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"App.tsx\" \"routes.ts\" \"index.tsx\" \"vite-env.d.ts\" \"components/**/*.{ts,tsx}\" \"permissions/**/*.{ts,tsx}\" \"services/**/*.{ts,tsx}\" \"design/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"index.css\" \"README.md\" \"docs/**/*.md\" \"eslint.config.js\" \"vite.config.ts\" \"vitest.config.ts\" \"playwright.config.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:server": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test tests/e2e/smoke.spec.ts tests/e2e/permissions.spec.ts tests/e2e/trip-operations.spec.ts tests/e2e/trip-details.spec.ts tests/e2e/trip-editor.spec.ts",
    "test:visual:phase2c": "playwright test tests/e2e/visual-phase2c.spec.ts",
    "test:visual:phase3c": "playwright test tests/e2e/visual-phase3c.spec.ts",
    "test:visual:phase3d": "playwright test tests/e2e/visual-phase3d.spec.ts",
    "test:visual:phase3e": "playwright test tests/e2e/visual-phase3e.spec.ts",
    "test:visual:phase4a": "playwright test tests/e2e/visual-phase4a.spec.ts",
    "test:visual:phase4b": "playwright test tests/e2e/visual-phase4b.spec.ts",
    "test:visual:phase4c": "playwright test tests/e2e/visual-phase4c.spec.ts",
    "test:visual:phase5a": "playwright test tests/e2e/visual-phase5a.spec.ts",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vis.gl/react-google-maps": "^1.8.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
